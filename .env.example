# =============================================================================
# RENOOS HOTEL — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` in production and replace placeholder values with strong secrets.
# =============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Network Configuration
# Set PORT according to your hosting provider (Render, Railway, VPS, Docker)
PORT=5173

# Network interface to bind to (0.0.0.0 is required for Docker / Cloud hosting)
HOST=0.0.0.0

# Management Tier: Administrator Security Passcode
# Used to authenticate at /admin for Executive PMS operations
ADMIN_PASSCODE=renoos2026

# Session Security: Cryptographic Secret for Admin Tokens
ADMIN_SESSION_SECRET=your_production_cryptographic_secret_here_32_characters_min

# Base Public URL (used for canonical links, sitemaps, and absolute URLs)
PUBLIC_SITE_URL=https://renooshotel.com
